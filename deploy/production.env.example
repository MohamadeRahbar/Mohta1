# Set these through the hosting process manager; never place secrets in the web root.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=https://mohta1.ir
COOKIE_SECURE=true
# Use an absolute PRIVATE directory, outside the domain document root.
DATA_DIR=/home/ACCOUNT/mohta1-data
# Keep signup closed until verification delivery is configured.
REGISTRATION_MODE=disabled
